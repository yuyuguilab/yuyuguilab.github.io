<!DOCTYPE html>
<html lang="{{ config.lang or config.language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ config.title }}{% endblock %}</title>
  <meta name="description" content="{{ (page.description or config.description) | escape }}">
  <link rel="stylesheet" href="{{ url_for('css/main.css') }}">
  <link rel="icon" type="image/jpeg" href="{{ url_for('images/logo.jpg') }}">
  <link rel="apple-touch-icon" href="{{ url_for('images/logo.jpg') }}">
  <link rel="canonical" href="{{ page.permalink or config.url }}">
  {% if page.layout === 'post' %}
  <meta property="og:type" content="article">
  <meta property="og:site_name" content="{{ config.title }}">
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:description" content="{{ (page.description or config.description) | escape }}">
  <meta property="og:url" content="{{ page.permalink }}">
  <meta property="og:image" content="{{ config.url }}{{ page.og_image or url_for('images/logo.jpg') }}">
  <meta name="twitter:card" content="summary_large_image">
  {% endif %}
  <meta name="google-site-verification" content="SZOADQgVtUTX2HeFvqhWxl-mcLWI0BocFt2b-LUZgJg" />
  {# Highwire citation meta tags (Google Scholar landing page) — posts opt in via front-matter #}
  {% if page.citation_doi %}
  <meta name="citation_title" content="{{ page.citation_title | escape }}">
  <meta name="citation_author" content="{{ page.citation_author | escape }}">
  <meta name="citation_publication_date" content="{{ page.citation_publication_date }}">
  <meta name="citation_doi" content="{{ page.citation_doi }}">
  <meta name="citation_abstract" content="{{ page.description | escape }}">
  <meta name="citation_pdf_url" content="{{ page.citation_pdf_url }}">
  {% endif %}
  <script>(function(){try{var t=localStorage.getItem('theme')||'auto';if(t!=='auto')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
</head>
<body>
  <main class="container">
    {% block content %}{% endblock %}
  </main>

  <footer class="footer">
    © {{ date_year }} {{ config.title }}
    <span class="footer-stats">
      <span id="busuanzi_container_site_pv" style="display:none">
        {{ __('stats.site_pv') }} <span id="busuanzi_value_site_pv"></span>
      </span>
      <span id="busuanzi_container_site_uv" style="display:none">
        · {{ __('stats.site_uv') }} <span id="busuanzi_value_site_uv"></span>
      </span>
    </span>
  </footer>

  <button id="back-to-top" title="Top" aria-label="Back to top">↑</button>
  <span id="busuanzi_container_page_pv" style="display:none"></span>
  <script src="{{ url_for('js/main.js') }}"></script>
  <script async src="//busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</body>
</html>
